# --------------------------------------------------------------------------
# HYDROVISION — variáveis de ambiente (copie para .env)
# --------------------------------------------------------------------------

# Opcional: modelo de linguagem para HYDRO AI. Sem chave, usa regras técnicas locais.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Opcional: persistência de execuções de simulação no Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# URL pública do backend quando frontend e API estiverem em serviços separados.
VITE_API_BASE_URL=

# ==========================================================================
# NOTIFICAÇÕES — canal no aplicativo + WhatsApp
# ==========================================================================
# O canal no aplicativo (SSE) já funciona sem configuração.
# O WhatsApp usa UM dos provedores abaixo. Sem provedor válido a API entra em
# "modo demonstração": gera a notificação no app e um link wa.me para envio manual.

# Provider: cloud (Meta), twilio, evolution, webhook ou demo.
# Se vazio, a API detecta automaticamente pelas credenciais presentes.
WHATSAPP_PROVIDER=
WHATSAPP_ENABLED=true

# Número padrão que recebe os alertas (somente dígitos, com DDI/DDD).
# Ex.: 5511999999999
WHATSAPP_DEFAULT_TO=

# Nível mínimo para disparo no WhatsApp: INFO | ATENCAO | CRITICO
WHATSAPP_MIN_SEVERITY=ATENCAO

# --- Opção 1: WhatsApp Cloud API (Meta) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FROM=
# Template aprovado (necessário para iniciar conversa fora da janela de 24h)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
# Token usado na verificação do webhook (GET /api/whatsapp/webhook)
WHATSAPP_VERIFY_TOKEN=

# --- Opção 2: Twilio ---
# https://www.twilio.com/docs/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Opção 3: Evolution API (WhatsApp não oficial / self-hosted) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- Opção 4: Webhook genérico (n8n, Make, Zapier, bot próprio) ---
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# Antiduplicidade e silêncio
NOTIFY_COOLDOWN_SECONDS=90
NOTIFY_QUIET_HOURS=
NOTIFY_TIMEZONE=America/Sao_Paulo
